# 记忆仓库的 Git 同步配置(team-memory sync 读取)
GITEA_REMOTE_URL=git@gitea.example.com:team/team-memory.git
# GITEA_TOKEN=  # 已停用 URL 注入，请使用 Git credential helper / SSH
TEAM_NAME={team_name}
DEFAULT_AUTHOR={author}

# Web 可视化(团队共享 — 服务器上只启动一次, 组员浏览器打开 WEB_PUBLIC_URL)
# WEB_HOST=0.0.0.0
# WEB_PORT=8765
# WEB_PUBLIC_URL=http://team-memory.example.com:8765
