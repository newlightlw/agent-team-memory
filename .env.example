# ============================================================
# Team Memory 配置
# ------------------------------------------------------------
# 复制为 .env 并填入你的值。本工具走纯 Git 路线。
# Gitea / GitHub / GitLab / Forgejo 等 Git 服务都可以作为远端。
# ============================================================

# Git 远程仓库地址 —— 支持 SSH 或 HTTPS+token 两种:
#   SSH   : git@gitea.example.com:team/team-memory.git
#   HTTPS : https://gitea.example.com/team/team-memory.git
REMOTE_URL=https://github.com/YOUR_ORG/team-shared-memory.git
# 兼容旧配置：GITEA_REMOTE_URL=...；新配置优先 REMOTE_URL，也可直接使用已有 origin。

# 仅当用 HTTPS + token 推送时需要; 用 SSH 方式可留空。
# 在你的 Git 服务中生成具有仓库读写权限的 token。
# GITEA_TOKEN URL 注入已停用；使用本人 Git credential helper / SSH，不把 token 写进 remote。

# 团队名 / 默认作者(写入记忆 frontmatter 的 author 字段)
TEAM_NAME=我们的团队
DEFAULT_AUTHOR=yourname

# 默认记忆仓库路径(init/sync/load/capture 不带 -p 时使用)
DEFAULT_MEMORY_PATH=./memory

# Web 可视化 — 团队固定地址(服务器上只启动一次 systemd/脚本, 组员直接浏览器访问)
# WEB_HOST=0.0.0.0          # 监听所有网卡(共享服务器必填)
# WEB_PORT=8765             # 固定端口, 避免与 8000 等常见 dev 端口冲突
# WEB_PUBLIC_URL=http://team-memory.example.com:8765   # 组员收藏的固定链接

# ============================================================
# 多源聚合(可选) —— 只读聚合已有 Markdown 知识库
# 留空则不聚合; 填路径后 load 可同时读取该源的记忆。
# ============================================================
EXTERNAL_MEMORY_PATH=
